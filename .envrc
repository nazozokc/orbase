# nix-direnv: devShell の評価結果をキャッシュしてリロードを高速化
nix_direnv_version 3

# 依存関係・パッケージ情報が変わったら自動リロード
# (flake.nix / flake.lock は use flake が watch する)
watch_file bun.lock
watch_file package.json
watch_file apps/orbase/package.json
watch_file docs/package.json
watch_file bun.nix
watch_file lefthook.yml

# ローカル固有の設定があれば読み込む (.gitignore 済み・無くても可)
source_env_if_exists .envrc.local

# bun install 済みなら各 workspace の node_modules/.bin を PATH に追加
if [[ -d node_modules/.bin ]]; then
  PATH_add node_modules/.bin
fi
if [[ -d apps/orbase/node_modules/.bin ]]; then
  PATH_add apps/orbase/node_modules/.bin
fi
if [[ -d docs/node_modules/.bin ]]; then
  PATH_add docs/node_modules/.bin
fi

use flake
